# Model roles in a HarnessGrad run.
#
# An agent is a harness plus a model. A *method* -- the thing that improves the
# harness -- may be an agent too, with its own model. These are different models
# doing different jobs, and they are configured separately because they will not
# stay the same:
#
#   the harness model   does the task          -> its score is the measurement
#   the method model    proposes the edits     -> its cost and quality shape what
#                                                 gets proposed, not how it scores
#
# Collapsing them would make a curve unreadable in two directions at once: a
# method that cannot diagnose well would look like a harness that cannot perform,
# and swapping the task model would silently change the method's behaviour too.
#
# The published evidence for keeping them apart is direct: one method's own table
# reports +14.1 points under a weaker model and +6.0 under a stronger one, with
# everything else held fixed. Which model sat behind the harness is part of the
# result, not a detail of the setup.
#
# Copy to `.env` (gitignored -- never commit real keys):
#
#   cp .env.example .env

# =============================================================================
# 1. The harness's model -- what the agent thinks with.
# =============================================================================
# Recorded on every curve point as `identity.agent_model`. A score without it is
# comparable to nothing.

# mock | openai
#   mock    deterministic stand-in: no network, no cost. Exercises the pipeline;
#           a score under it says nothing about any model.
#   openai  any OpenAI-compatible endpoint.
HG_AGENT_BACKEND=mock

# --- required when HG_AGENT_BACKEND=openai ---
HG_AGENT_MODEL=
HG_AGENT_BASE_URL=
HG_AGENT_API_KEY=

# --- optional ---
HG_AGENT_TIMEOUT_S=180      # seconds before one completion is abandoned
HG_AGENT_RETRIES=3          # attempts per completion; retries are counted

# --- a locally served model (no API key, no network) ---
#
# Nothing in the platform changes for this. `openai` already means "any
# OpenAI-compatible endpoint", and vLLM serves exactly that, so a local model is a
# configuration rather than a code path:
#
#   /mnt/20t/xubuqiang/venvs/harnessgrad/bin/vllm serve <model-dir> \
#       --served-model-name qwen3-30b-local --tensor-parallel-size 2 \
#       --host 127.0.0.1 --port 8001
#
# HG_AGENT_BACKEND=openai
# HG_AGENT_MODEL=qwen3-30b-local
# HG_AGENT_BASE_URL=http://127.0.0.1:8001/v1
# HG_AGENT_API_KEY=local
#
# `HG_AGENT_API_KEY` is a placeholder here: vLLM does not authenticate, but the
# client library refuses to build without a value. Be aware of what the run record
# will therefore say -- `describe_model()` reports "credentials: present" for a local
# server exactly as it does for a hosted one, because from inside the platform the two
# are the same shape. It is not a claim that a key was verified.
#
# A local model is still recorded on every curve point (`identity.agent_model`), and
# that matters more here than with a hosted model, not less: two people can run "the
# same model" at different quantisations, context limits or tensor-parallel layouts,
# and this field is the only place the difference can show up.

# =============================================================================
# 2. The method's model -- what the improver thinks with.
# =============================================================================
# Only needed by methods that call a model (e.g. methods/llm_improver). A method
# that edits by rule needs none of this, and a method that calls a model brings
# its own credentials: the platform does not supply them, because supplying them
# would make the platform a participant in the method.
#
# Loaded into the method's subprocess, never into the harness's -- the harness
# must not be able to reach the method's endpoint.

HG_METHOD_MODEL=
HG_METHOD_BASE_URL=
HG_METHOD_API_KEY=
HG_METHOD_TIMEOUT_S=180

# =============================================================================
# 3. The environment's model -- what a *service* thinks with.
# =============================================================================
# A third budget, after the harness's and the method's (INTERFACE.md §2.5.7). Only
# needed by a dataset whose service declares `needs_model: True` -- typically a
# simulated user, which is an LLM being asked to play a person. A dataset whose
# services call no model needs none of this, and `env.model` is then recorded as
# `null` on every curve point, which is a fact about the run rather than a gap.
#
# Handed to the **service containers only**. The harness never sees it: `HG_ENV_*`
# is stripped by `harness_env()`, and `eval/container.py` forwards an allowlist that
# contains `HG_AGENT_*` and not this. An environment whose simulator can spend the
# agent's credential is an environment that can impersonate the agent.
#
# The platform refuses to start a run whose dataset declares `needs_model` while
# this is unset, rather than passing an empty string: a simulator with no model
# produces a task that fails for a reason nothing records.

HG_ENV_MODEL=
HG_ENV_BASE_URL=
HG_ENV_API_KEY=

# The environment's seed. Drawn at random when unset and recorded on every curve
# point as `env.seed`, so a recorded run can be reproduced by passing it back
# (`driver.py --seed`). A per-task seed is derived from it, so two runs with the
# same value give the same environment.
# HG_ENV_SEED is NOT an operator knob -- it is an *output*: the platform sets
# it per task from HARNESSGRAD_SEED (`eval/services.py:task_seed`) and a value
# in this file is overwritten. Declared in `harnessgrad/config/areas.py` so its
# presence is recorded, and asserted by
# `tests/quality/test_services.py::test_a_service_gets_a_derived_seed_not_the_host_s`.

# =============================================================================
# 4. The verifier's judge -- separate from the agent and environment models.
# =============================================================================
# The endpoint/key are shared by judge-using datasets and stay in the host broker.
# Model selection: dataset override > HG_JUDGE_MODEL > dataset official default.
# Blank optional values mean unset. Unavailable selected models fail without retry
# or switching models. The resolved model is fixed in each verifier and its receipt.
HG_JUDGE_MODEL=
HG_JUDGE_BASE_URL=
HG_JUDGE_API_KEY=

# Optional dataset overrides; no need to repeat the value in HG_JUDGE_MODEL.
# MemoryAgentBench defaults by source: summary gpt-4o-2024-05-13, QA gpt-4o.
HG_MAB_JUDGE_MODEL=
# StrongREJECT defaults to gpt-4o-mini-2024-07-18.
HG_STRONGREJECT_JUDGE_MODEL=
# Tau3 has no implicit judge model: set this or HG_JUDGE_MODEL for NL scoring.
HG_TAU3_JUDGE_MODEL=
# Optional MemoryAgentBench output limit (1–16384). Blank keeps summary=4096,
# QA=10. An override applies to both sources and changes the scoring identity.
HG_MAB_JUDGE_MAX_OUTPUT_TOKENS=

# The egress proxy the platform hands to a task's *check* (never to the harness: a harness
# reaches its model through the platform, and a proxy in front of that breaks it). Some
# checks bootstrap their own test runner over the internet -- `curl https://astral.sh/uv/...`
# -- and on a host whose egress to those hosts is blocked the check never runs, which is
# recorded as a task the harness failed rather than a task nobody measured. Unset by default.
# `tools/egress_forwarder.py` publishes the machine's proxy on the docker bridge for
# exactly this (a container cannot reach the host's 127.0.0.1), and prints the value:
#   python3 tools/egress_forwarder.py          # then, here:
#   HG_EGRESS_PROXY=http://172.17.0.1:17890

# The improver (`improvers/improvers.json`) defaults to the `deepseek`
# endpoint, so `python3 driver.py` with no `--improver` needs this. A method
# reaches it through HG_METHOD_* (injected by the platform), never through this
# name: the entry declares `api_key_env` and the platform copies the value across.
DEEPSEEK_API_KEY=
