---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSwitch from './LanguageSwitch.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length);
const zh = /^\/zh(?:\/|$)/.test(path);
const local = zh ? '/zh' : '';
const section = /^\/(?:zh\/)?(news|blog)(\/|$)/.exec(path)?.[1] || 'docs';
const links = [[zh ? '首页' : 'Home', `${base}${local}/`, 'home'], [zh ? '文档' : 'Docs', `${base}${local}/getting-started/`, 'docs'], [zh ? '新闻' : 'News', `${base}${local}/news/`, 'news'], [zh ? '博客' : 'Blog', `${base}${local}/blog/`, 'blog'], ['GitHub', 'https://github.com/zjunlp/HarnessGrad', 'github']];
---
<div class="hg-header">
  <a class="hg-wordmark" href={`${base}${local}/`} aria-label="HarnessGrad home"><svg width="28" height="28" viewBox="6 10 51 48" aria-hidden="true"><g fill="currentColor"><rect x="8" y="48" width="9.5" height="8" rx="2.5"/><rect x="20.5" y="42" width="9.5" height="14" rx="2.5"/><rect x="33" y="31" width="9.5" height="25" rx="2.5"/><rect x="45.5" y="12" width="9.5" height="44" rx="2.5"/></g></svg>HarnessGrad</a>
  <nav class="hg-nav" aria-label={zh ? '主导航' : 'Main navigation'}>{links.map(([label, href, id]) => <a href={href} aria-current={section === id ? 'page' : undefined}>{label}</a>)}</nav>
  <div class="hg-tools"><LanguageSwitch /><Search /><ThemeSelect /></div>
</div>
