---
import BenchmarkChart from './BenchmarkChart.astro';
import BenchmarkFilter from './BenchmarkFilter.astro';
import data from '../data/results/scienceworld.json';

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const stack = data.stacks[0];
const { methods } = stack;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const records = `https://huggingface.co/datasets/Xubqpanda/HarnessGrad/tree/${data.revision}/Experiments/ScienceWorld/qwen3.5-9b_loop/${stack.id}`;
const existingMethodPages = import.meta.glob('../content/docs/methods/*.mdx');
const methodLink = (name: string) => `../content/docs/methods/${name}.mdx` in existingMethodPages
  ? `${base}/methods/${name}/`
  : `${records}/${name}`;
const score = (value: number | null | undefined) => value == null ? '—' : value.toFixed(3);
const tokens = (value: number | null) => value == null ? '—' : (value / 1e6).toFixed(2);
const options = (values: string[]) => values.map((value) => ({ value, label: value }));
const rounds = methods[0].rounds.map(({ round }) => round);
const studies = [
  { pool: 'train', description: zh ? '训练集' : 'study split',
    chart: zh ? '每轮训练分数' : 'Study score by round' },
  { pool: 'dev', description: zh ? '用于选择轮次的验证集' : 'validation split, the pool a round is chosen on',
    chart: zh ? '各检查点的验证分数' : 'Score by checkpoint round on dev' },
] as const;
const splits = (['train', 'dev', 'test'] as const).map((pool) => ({
  value: pool, label: pool, count: data.pools[pool], h0: score(data.reference[pool]),
}));
const attributes = {
  'data-base-harness': stack.baseHarness,
  'data-task-model': stack.taskModel,
  'data-meta-model': stack.metaModel,
  'data-meta-harness': stack.metaHarness,
};
const devPoints = methods.reduce((total, method) => total + method.rounds.filter(
  ({ round, eval: evaluation }) => round > 0 && evaluation.dev != null,
).length, 0);
const gapSubtotals = methods.flatMap((method) => method.rounds.flatMap((round) => {
  const gap = 'gapSubtotal' in round ? round.gapSubtotal : undefined;
  return gap ? [{ method: method.name, round: round.round, ...gap }] : [];
}));
const testRows = [...methods].sort((a, b) => b.testScore - a.testScore);
---

<BenchmarkFilter
  slug={data.slug}
  splits={splits}
  methods={options(methods.map(({ name }) => name))}
  taskModels={options([stack.taskModel])}
  baseHarnesses={options([stack.baseHarness])}
  metaModels={options([stack.metaModel])}
  metaHarnesses={options([stack.metaHarness])}
/>

<p>{zh
  ? `${methods.length} 种方法 · ${devPoints} 个已发布验证轮次（不含 H0）`
  : `${methods.length} methods · ${devPoints} published validation points (excluding H0)`} · <a href={records}>{zh ? 'Hugging Face 原始记录' : 'Published records on Hugging Face'}</a></p>

{studies.map(({ pool, description, chart }) => (
  <section data-split={pool} {...attributes}>
    <h3 id={pool}><code>{pool}</code> · {data.pools[pool]} {zh ? '道任务' : 'tasks'} · H0 {score(data.reference[pool])} · {description}</h3>
    <BenchmarkChart slug={data.slug} pool={pool} alt={chart} />

    <p><strong>{zh ? '分数' : 'Score'} — <code>{pool}</code></strong></p>
    <div class="hg-table">
      <table>
        <thead><tr><th scope="col">{zh ? '方法' : 'method'}</th>
          {rounds.map((round) => <th scope="col">{round === 0 ? 'r0 (H0)' : `r${round}`}</th>)}
        </tr></thead>
        <tbody>{methods.map((method) => (
          <tr data-method-row={method.name}>
            <td><a href={methodLink(method.name)}><code>{method.name}</code></a></td>
            {method.rounds.map((round) => {
              const inherited = round.inherited;
              const source = inherited ? method.rounds[inherited.sourceRound] : round;
              const value = pool === 'train' ? source.train : source.eval.dev;
              const note = inherited && (zh
                ? `Harness 运行失败，沿用父代 r${inherited.parentRound} 的分数（实测自 r${inherited.sourceRound}）`
                : `Harness failed. Inherited from parent r${inherited.parentRound} (measured at r${inherited.sourceRound}).`);
              return <td title={note} data-inherited-from={inherited?.parentRound}>
                {score(value)}{note && <sup aria-label={note}>†</sup>}
              </td>;
            })}
          </tr>
        ))}</tbody>
      </table>
    </div>

    <p><strong>{zh ? '开销 — 任务智能体的逐轮 token 用量' : 'Cost — task-agent tokens per round'}</strong></p>
    <div class="hg-table">
      <table>
        <caption>
          {zh ? '单位为百万 token。in 为输入，out 为输出。— 表示整轮用量未知。'
              : 'Millions of tokens (M). in = input, out = output. A dash marks an unavailable round total.'}
          {pool === 'train' && <>{zh ? ' 逐题对账涵盖原始训练调用，含轨迹重算。' : ' Reconciled rounds count original Train calls and include trace-based reconstruction.'}
            {' '}<a href={data.accountingSource}>{zh ? '逐题数字与统计口径' : 'Per-task figures and accounting rules'}</a></>}
        </caption>
        <thead>
          <tr><th scope="col" rowspan="2">{zh ? '方法' : 'method'}</th>
            {rounds.slice(pool === 'train' ? 1 : 0).map((round) => <th colspan="2">r{round}</th>)}
          </tr>
          <tr>{rounds.slice(pool === 'train' ? 1 : 0).map(() => <><th scope="col">in</th><th scope="col">out</th></>)}</tr>
        </thead>
        <tbody>{methods.map((method) => (
          <tr data-method-row={method.name}>
            <td><a href={methodLink(method.name)}><code>{method.name}</code></a></td>
            {method.rounds.slice(pool === 'train' ? 1 : 0).map((round) =>
              ((pool === 'train' ? round.trainCost : round.devCost) ?? [null, null])
                .map((value) => <td>{tokens(value)}</td>))}
          </tr>
        ))}</tbody>
      </table>
    </div>

    {pool === 'train' && <p>{zh ? '以下轮次仅列已对账缺项的小计（输入 / 输出 token）：' : 'Reconciled gap subtotals for rounds with incomplete coverage (input / output tokens): '}
      {gapSubtotals.map((gap, i) => <>{i > 0 && ' · '}<code>{gap.method}</code> R{gap.round} ({gap.tasks} {zh ? '题' : 'tasks'}) {gap.input_tokens.toLocaleString('en-US')} / {gap.output_tokens.toLocaleString('en-US')}</>)}
    </p>}

    <p><strong>{zh ? '开销 — 生成检查点的逐轮改进 token 用量' : 'Cost — improver tokens per checkpoint round'}</strong></p>
    <div class="hg-table">
      <table>
        <caption>{zh ? '单位为百万 token。in 为输入，cache 为缓存读取，out 为输出。↳ 表示用量已计入同批的首个候选。'
          : 'Millions of tokens (M). in = input, cache = cache reads, out = generated tokens. ↳ shares the spend of the first candidate in the submission.'}</caption>
        <thead>
          <tr><th scope="col" rowspan="2">{zh ? '方法' : 'method'}</th>
            {rounds.slice(1).map((round) => <th colspan="3">r{round}</th>)}
          </tr>
          <tr>{rounds.slice(1).map(() => <><th scope="col">in</th><th scope="col">cache</th><th scope="col">out</th></>)}</tr>
        </thead>
        <tbody>{methods.map((method) => (
          <tr data-method-row={method.name}>
            <td><a href={methodLink(method.name)}><code>{method.name}</code></a></td>
            {method.rounds.slice(1).map((round) => round.improverCost.map(
              (value) => <td>{round.sharedImproverCost ? '↳' : tokens(value)}</td>))}
          </tr>
        ))}</tbody>
      </table>
    </div>

    <p>{zh
      ? 'r0 是共享的 H0。† 和曲线上的空心方点表示 Harness 运行失败，该轮显示父代分数。失败轨迹保留在原始记录中。'
      : 'Round 0 is shared H0. † and hollow squares mark a Harness failure with the score carried forward from its parent. The published records retain the failed attempts.'}</p>
  </section>
))}

<section data-split="test" {...attributes}>
  <h3 id="test"><code>test</code> · {data.pools.test} {zh ? '道任务' : 'tasks'}</h3>
  <BenchmarkChart slug={data.slug} pool="test" alt={zh ? '各方法的测试分数' : 'Test score per method'} />
  <div class="hg-table">
    <table>
      <thead><tr>
        <th scope="col">{zh ? '方法' : 'method'}</th>
        <th scope="col">{zh ? 'dev 选定轮次' : 'chosen on dev'}</th>
        <th scope="col">dev ({data.pools.dev})</th>
        <th scope="col">test ({data.pools.test})</th>
      </tr></thead>
      <tbody>{testRows.map((method) => (
        <tr data-method-row={method.name}>
          <td><a href={methodLink(method.name)}><code>{method.name}</code></a></td>
          <td>r{method.selectedRound}</td><td>{score(method.devScore)}</td><td><strong>{score(method.testScore)}</strong></td>
        </tr>
      ))}</tbody>
    </table>
  </div>
</section>
