{
  "name": "miniagent",
  "version": "0.2.0",
  "path": ".",
  "entrypoint": "agent.py",
  "backend": "cli",
  "install": "requirements.lock",
  "runtime": {
    "kind": "python",
    "python": "3.12",
    "requirements": "requirements.lock"
  },
  "env_kinds": [
    "files"
  ],
  "runtime_paths": [],
  "role": "harness",
  "notes": "Native MiniAgent runtime vendored from RUC-NLPIR/FlashRSI at dea1b1d0285e3328234a1e344562bb9e54ce14f7. Sandboxed native files tasks use a managed CPython 3.12 environment with the complete requirements.lock. The runtime and resource files remain candidate-owned and may be edited by a method. Container/exec and unsandboxed execution are unsupported.",
  "components": {
    "context": [
      "agent.yaml",
      "prompts/extract.md",
      "prompts/system.md",
      "runtime/workspace.py",
      "skills/main.md"
    ],
    "tools": [
      "runtime/editor.py",
      "runtime/reader.py",
      "runtime/tool_result.py",
      "runtime/tools.py",
      "tool_descriptions/read_skill.json",
      "tool_descriptions/shell.json",
      "tools/read_skill.py",
      "tools/shell.py"
    ],
    "control": [
      "harness.json",
      "runtime/agent.py",
      "runtime/llm.py"
    ],
    "memory": [
      "runtime/trace.py"
    ],
    "cost": [
      "bridge.py"
    ],
    "safety": [
      "runtime/web_config.py"
    ],
    "unattributed": [
      "components.yaml",
      "LICENSE.upstream",
      "PROVENANCE.json",
      "README.md",
      "requirements.lock",
      "requirements.txt",
      "runtime/__init__.py"
    ],
    "delegation": [
      "agent.py"
    ]
  }
}
