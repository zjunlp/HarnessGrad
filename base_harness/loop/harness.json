{
  "name": "loop",
  "version": "0.3.0",
  "path": ".",
  "entrypoint": "agent.py",
  "backend": "cli",
  "install": "requirements.lock",
  "env_kinds": [
    "files",
    "exec"
  ],
  "components": {
    "control": [
      "agent.py",
      "harness.json"
    ],
    "unattributed": [
      "requirements.txt",
      "requirements.lock",
      "requirements-py310.lock",
      "requirements-py39.lock",
      "README.md"
    ]
  },
  "runtime": {
    "kind": "python",
    "python": "3.12",
    "requirements": "requirements.lock",
    "exec": {
      "requirements": {
        "3.9": "requirements-py39.lock",
        "3.10": "requirements-py310.lock",
        "3.11": "requirements.lock",
        "3.12": "requirements.lock",
        "3.13": "requirements.lock"
      }
    }
  }
}
