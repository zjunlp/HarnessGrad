#!/usr/bin/env python3
r"""ScienceWorld stdlib actor CLI: look, do, inventory, task and done.

The trusted service owns the selected world, pinned dependencies and JVM.
Each observation replays the local action history in that selected world.
Only successful actions append to scw_actions.jsonl; the original 100-step
budget, room/status/feedback output and done marker are preserved.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import scw_client as scw_env  # noqa: E402


def _fail(message: str, code: int = 2) -> int:
    print(f"error: {message}", file=sys.stderr)
    return code


def _replay(workdir: Path, actions: list[str], budget: int):
    """Build the world and apply `actions`, returning `(env, last_step)`.

    `last_step` is the `(observation, reward, done, info)` of the final action, or None
    when there were none. Both this and the check call it, so the two cannot disagree
    about what an action does.
    """
    return scw_env.replay(actions, budget)



def _print_status(step, *, moves: int, budget: int, env) -> None:
    """Print the **current** room, the score readout, and the last action's feedback.

    The room always comes from `env.look()`, never from `step[0]`. `_replay` has already
    applied every logged action, so `env` is at the current state; `step[0]` is the
    *previous* action's feedback ("You open the door."), which is a different thing and
    used to be printed in place of the room. Measured in ScienceWorld 1.2.3: five calls to
    `look()` leave `get_num_moves()` and `getScore()` unchanged, so reading the room
    cannot cost a move or move the grade -- and it appends nothing to the log, because
    only `cmd_do` writes there.
    """
    if step is None:
        score = 0
        done = False
    else:
        _observation, _reward, done, info = step
        score = info.get("score", 0)
    print(str(env.look()).strip())
    print()
    print(f"[scw] move {moves}/{budget}; score {score}/100"
          + ("; episode over" if done else "; in progress"))
    if step is not None:
        feedback = str(step[0]).strip()
        if feedback:
            print(f"[scw] last action (move {moves}): {feedback}")


def cmd_look(args) -> int:
    records = scw_env.action_log_records(args.log)
    actions = scw_env.actions_in(records)
    env, last = _replay(args.workdir, actions, args.budget)
    _print_status(last, moves=len(actions), budget=args.budget, env=env)
    return 0


def cmd_do(args) -> int:
    action = " ".join(args.action).strip()
    if not action:
        return _fail('usage: scw do "<action>"')
    records = scw_env.action_log_records(args.log)
    actions = scw_env.actions_in(records)
    if len(actions) >= args.budget:
        print(f"error: the {args.budget}-step budget is spent; the episode is over. "
              f"Use `scw look` to see the final state.", file=sys.stderr)
        return 2
    env, last = _replay(args.workdir, actions + [action], args.budget)
    scw_env.append_action(args.log, action, len(actions))
    _print_status(last, moves=len(actions) + 1, budget=args.budget, env=env)
    return 0


def cmd_inventory(args) -> int:
    records = scw_env.action_log_records(args.log)
    env, _ = _replay(args.workdir, scw_env.actions_in(records), args.budget)
    print(str(env.inventory()).strip())
    return 0


def cmd_task(args) -> int:
    records = scw_env.action_log_records(args.log)
    env, _ = _replay(args.workdir, scw_env.actions_in(records), args.budget)
    print(str(env.get_task_description()).strip())
    return 0


def cmd_done(args) -> int:
    records = scw_env.action_log_records(args.log)
    if not any(r.get("kind") == "done" for r in records):
        path = args.log
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as handle:
            handle.write(json.dumps({"kind": "done",
                                     "step": len(scw_env.actions_in(records))}) + "\n")
    print("Noted. The episode is marked done.")
    return 0


def _parse_global(argv: list) -> tuple[argparse.Namespace, list]:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--workdir", default=".")
    parser.add_argument("--log", default=None)
    parser.add_argument("--budget", type=int, default=scw_env.STEP_BUDGET)
    known, rest = parser.parse_known_args(argv)
    known.workdir = Path(known.workdir)
    known.log = Path(known.log) if known.log else known.workdir / scw_env.LOG_FILENAME
    return known, rest


USAGE = """scw -- act in a ScienceWorld episode

  python3 scw look            the room you are in now (free: costs no move) and the score
  python3 scw do "<action>"   apply one action; it costs one of the {budget} moves
  python3 scw inventory       what you are carrying
  python3 scw task            the task description
  python3 scw done            declare the episode over

Options (anywhere on the line): --workdir DIR --log FILE --budget N
The task is {task}; the action log is {log}.
""".format(budget=scw_env.STEP_BUDGET, task=scw_env.TASK_FILENAME,
           log=scw_env.LOG_FILENAME)


def main(argv: list) -> int:
    args, rest = _parse_global(list(argv))
    if not rest or rest[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    command, rest = rest[0], rest[1:]
    if command == "look":
        return cmd_look(args)
    if command == "do":
        args.action = rest
        return cmd_do(args)
    if command == "inventory":
        return cmd_inventory(args)
    if command == "task":
        return cmd_task(args)
    if command == "done":
        return cmd_done(args)
    print(f"error: unknown command {command!r}", file=sys.stderr)
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
