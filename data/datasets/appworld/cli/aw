#!/usr/bin/env python3
"""Execute one Python snippet per invocation in the AppWorld service."""
from __future__ import annotations
import argparse
import json
import os
import pathlib
import urllib.request

BASE = os.environ.get("HG_SVC_APPWORLD_URL", "http://appworld:8000")
MARKER = pathlib.Path(".appworld_task")


def post(path: str, payload: dict) -> object:
    request = urllib.request.Request(
        BASE + path,
        data=json.dumps(payload).encode(),
        headers={"content-type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=120) as response:
        body = json.loads(response.read())
    return body.get("output")


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Run init once, then action. Python runs in the persistent service "
               "interpreter with apis already defined. Discover APIs with "
               "print(apis.api_docs.show_app_descriptions()), then "
               "show_api_descriptions(app_name=...) and "
               "show_api_doc(app_name=..., api_name=...) on apis.api_docs.")
    commands = parser.add_subparsers(dest="command", required=True)
    init = commands.add_parser("init", help="Initialize the world and show task metadata (resets state).")
    init.add_argument("--task", required=True)
    action = commands.add_parser(
        "action", help="Execute a Python snippet (possibly multiple API calls) in the service.",
        description="Execute Python in the persistent service interpreter; apis is "
                    "already defined. A snippet may contain multiple API calls, "
                    "assignments, loops and conditionals. Print API responses to inspect results.")
    action.add_argument("--task", required=True)
    action.add_argument("--code", required=True,
                        help="Python, e.g. 'print(apis.api_docs.show_app_descriptions())'")
    args = parser.parse_args()
    if args.command == "init":
        output = post("/initialize", {"task_id": args.task, "experiment_name": "harness"})
        MARKER.write_text(args.task, encoding="utf-8")
        print(json.dumps(output, default=str))
        return 0
    if not MARKER.is_file() or MARKER.read_text(encoding="utf-8").strip() != args.task:
        post("/initialize", {"task_id": args.task, "experiment_name": "harness"})
        MARKER.write_text(args.task, encoding="utf-8")
    output = post("/execute", {"task_id": args.task, "code": args.code})
    if output is not None:
        print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
