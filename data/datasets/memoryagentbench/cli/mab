#!/usr/bin/env python3
"""Read one ordered material/question, acknowledge it, or submit a final answer."""
import argparse
import hashlib
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from mab_transport import call


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='operation', required=True)
    sub.add_parser('next')
    ack = sub.add_parser('ack')
    ack.add_argument('--chunk-id', required=True)
    ack.add_argument('--request-id', required=True)
    submit = sub.add_parser('submit')
    submit.add_argument('--question-id', required=True)
    submit.add_argument('--request-id', required=True)
    submit.add_argument('--answer-file', required=True, type=Path)
    args = parser.parse_args()
    payload = {}
    if args.operation == 'ack':
        payload = {'chunk_id': args.chunk_id, 'request_id': args.request_id}
    elif args.operation == 'submit':
        with args.answer_file.open('rb') as stream:
            raw = stream.read(65537)
        if len(raw) > 65536:
            parser.error('answer exceeds 65536 UTF-8 bytes')
        payload = {'question_id': args.question_id, 'request_id': args.request_id,
                   'answer': raw.decode('utf-8')}
    result = call('/run/harnessgrad-tool/tool.sock', args.operation, payload)
    if 'text' in result:
        raw = result.pop('text').encode('utf-8')
        digest = hashlib.sha256(raw).hexdigest()
        directory = Path('mab-inputs')
        directory.mkdir(exist_ok=True)
        path = directory / (digest + '.txt')
        path.write_bytes(raw)
        result.update(path=str(path), bytes=len(raw), sha256=digest)
    print(json.dumps(result, ensure_ascii=False))
    return 1 if result.get('accepted') is False else 0


if __name__ == '__main__':
    raise SystemExit(main())
