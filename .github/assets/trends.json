  "x": "round index; round 0 is the harness as handed to the method",
  "y": "training-side score, axis unlabelled on purpose",
  "lines": "one per method, colour identifies it and is the same in both panels",
  "not_shown": "held-out scores, cross-benchmark comparison, confidence intervals, averages"
 },
