[{"id":"0f7faf33a3908546c6fd5b73a660e0f8ff173c2f","title":"Convert dataset to Parquet (#8)","message":"\n\n\n- Convert dataset to Parquet (6baa09772e6ddf7e7b5d629ea64f1a8c1df21c3c)\n- Add rc.nocontext data files (279d93a6e999c93dc992e1a705389e350ba7f706)\n- Add unfiltered data files (part 00001-of-00002) (87a3c8085e004c925fba5a31831e5e7ffc2dda58)\n- Add unfiltered data files (part 00000-of-00002) (55b099b979da6a1857779c8f1df87105879a191a)\n- Add unfiltered.nocontext data files (640d3785c8080b8c2cef6ddc1e083b4c3596add0)\n- Add rc.web data files (a2820de3fe2f7e9159ddd2703649692a5f7af6dd)\n- Add rc.web.nocontext data files (2cc307f5321796c0ce8d4bab1b0c12b478844be9)\n- Add rc.wikipedia data files (8d35a53732b44b4b615c00855fe40f965b8f13e9)\n- Add rc.wikipedia.nocontext data files (a0a1708169dbeefee25332a5c8eaebbc4d8726da)\n- Delete loading script (f59b4da4d92cf18e0c8a9211c9d7376eaadccb1f)\n- Delete data folder (8dc2b82074533f20e92858f3577f10ff192f48cc)\n\n","authors":[{"user":"albertvillanova","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/1606406298765-noauth.jpeg"}],"date":"2024-01-05T13:24:37.000Z"},{"id":"d63a76f01c8226449f76b437dd512cf8b17adf5d","title":"Support streaming (#5)","message":"\n\n\n- Host data files in ZIP archives (22a83321a05a4e2a340f035521c7ee3a1c6343ba)\n- Update loading script (fed7a66769b4830e9344f137fb7e8ef0348f7600)\n- Delete legacy metadata JSON file (ec52b242b15f48ef92869cc33d0cb56e7511dc41)\n\n","authors":[{"user":"albertvillanova","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/1606406298765-noauth.jpeg"}],"date":"2023-06-09T15:34:16.000Z"},{"id":"581155e8f913b60746006263beb49d4194dfe171","title":"Convert dataset sizes from base 2 to base 10 in the dataset card (#3)","message":"\n\n\n- Convert dataset sizes from base 2 to base 10 in the dataset card (4d43bb79b628cd3cc51ee64ed80d444bbcf6b36b)\n\n","authors":[{"user":"albertvillanova","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/1606406298765-noauth.jpeg"}],"date":"2023-04-05T13:42:32.000Z"},{"id":"88ce2dca1ab351ba11fe37dbc7a0a3bfde74fc09","title":"Reorder split names (#2)","message":"\n\n\n- Reorder split names (5fc90627acdee826ec55082bdbc887bc9e308a88)\n\n","authors":[{"user":"albertvillanova","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/1606406298765-noauth.jpeg"}],"date":"2022-11-18T21:56:30.000Z"},{"id":"35a534c59de67132b80dde63f37f9aed75aeef93","title":" add dataset_info in dataset metadata","message":"\n","authors":[{"user":"lhoestq","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/5e9ecfc04957053f60648a3e/UY4H1oMtmXVo1p-HnKV6l.png"}],"date":"2022-11-03T16:47:40.000Z"},{"id":"461a4265edc59265c7e397fbd3ca5aea6025ae2d","title":" remove dummmy data","message":"\n","authors":[{"user":"mariosasko","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/605fee52a88baa3edbe43fce/5IfYnbpUg5LqmebWqbIM7.jpeg"}],"date":"2022-10-28T16:41:43.000Z"},{"id":"826e3a12bac7b0bc83ff0c9288658b71d3146e3f","title":" Align more metadata with other repo types (models,spaces) (#4607)","message":"\n\n* language(s) and license(s) for consistency\n\n* `licenses:` => `license:`\n\n* `languages:` => `language:`\n\n* backward-compat\n\n* make style\n\n* set default values for deprecated languages and licenses\n\nCo-authored-by: Quentin Lhoest <lhoest.q@gmail.com>\n\n Commit from https://github.com/huggingface/datasets/commit/a5192964dc4b76ee5c03593c11ee56f29bbd688d\n","authors":[{"user":"julien-c","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/5dd96eb166059660ed1ee413/NQtzmrDdbG0H8qkZvRyGk.jpeg"}],"date":"2022-07-01T11:56:51.000Z"},{"id":"d2a6a678b772b3d9a6d654bc6328ed674e2b6201","title":" Remove a copy-paste sentence in dataset cards (#4281)","message":"\n\n Commit from https://github.com/huggingface/datasets/commit/bf6108b8e09fae44787a6a7b20b8718c6e86dd7f\n","authors":[{"user":"albertvillanova","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/1606406298765-noauth.jpeg"}],"date":"2022-05-04T18:35:04.000Z"},{"id":"1da0cdd05b0e1fb24e72da5cb88318ab939a7895","title":" Update datasets task tags to align tags with models (#4067)","message":"\n\n* update tasks list\n\n* update tags in dataset cards\n\n* more cards updates\n\n* update dataset tags parser\n\n* fix multi-choice-qa\n\n* style\n\n* small improvements in some dataset cards\n\n* allow certain tag fields to be empty\n\n* update vision datasets tags\n\n* use multi-class-image-classification and remove other tags\n\n Commit from https://github.com/huggingface/datasets/commit/edb4411d4e884690b8b328dba4360dbda6b3cbc8\n","authors":[{"user":"lhoestq","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/5e9ecfc04957053f60648a3e/UY4H1oMtmXVo1p-HnKV6l.png"}],"date":"2022-04-13T19:21:10.000Z"},{"id":"07f3581e1c563c991c1222d83728fd90978cf96b","title":" Update files from the datasets library (from 1.17.0)","message":"\n\n Release notes: https://github.com/huggingface/datasets/releases/tag/1.17.0\n","authors":[{"user":"system","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/1646125250765-61af81e7a7205fb7cc9ec0cb.png"}],"date":"2022-01-25T15:51:36.000Z"},{"id":"5153029519c6f25035b24509ad0a388c057b2fca","title":" Update files from the datasets library (from 1.13.0)","message":"\n\n Release notes: https://github.com/huggingface/datasets/releases/tag/1.13.0\n","authors":[{"user":"system","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/1646125250765-61af81e7a7205fb7cc9ec0cb.png"}],"date":"2022-01-25T15:48:57.000Z"},{"id":"996764ab35a7d49099df7ed1d90ff41c088d8b58","title":" Update files from the datasets library (from 1.8.0)","message":"\n\n Release notes: https://github.com/huggingface/datasets/releases/tag/1.8.0\n","authors":[{"user":"system","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/1646125250765-61af81e7a7205fb7cc9ec0cb.png"}],"date":"2022-01-25T15:46:30.000Z"},{"id":"6e34768576